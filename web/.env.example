# Safe default: validates the website/API path without launching Gazebo.
AEROLAND_RUNNER_MODE=demo

# Used by the Streamlit website.
AEROLAND_SIM_API_URL=http://127.0.0.1:8000

# Required after switching AEROLAND_RUNNER_MODE to gazebo.
AEROLAND_WORKSPACE=~/aeroland_ws
PX4_AUTOPILOT_DIR=~/PX4-Autopilot
AEROLAND_START_XRCE=1
AEROLAND_MISSION_TIMEOUT=180

# Keep the local prototype private.
AEROLAND_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
